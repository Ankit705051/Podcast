generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  userName  String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatar    String?

  googleId              String?
  bio                   String?
  last_active           DateTime             @default(now())
  last_login            DateTime             @default(now())
  last_logout           DateTime?
  location              String?
  password              String
  resetPasswordExpire   DateTime?
  resetPasswordToken    String?
  role                  Role                 @default(user)
  settings              Json?
  social_links          Json?
  storage_quota_mb      Int                  @default(100)
  storage_used_mb       Int                  @default(0)
  stripe_customer_id    String?              @unique
  subscription_end_date DateTime?
  subscription_status   SubscriptionStatus   @default(active)
  subscription_type     SubscriptionType     @default(free)
  verificationToken     String?
  verified              Boolean              @default(false)
  chats                 Chat[]
  pollVotes             PollVote[]
  questions             Question[]
  recordings            RecordingSession[]
  sessions              Session[]
  sessionParticipants   SessionParticipant[]
  subscriptions         Subscription[]
  payments              Payment[]
}

model Session {
  id                   String               @id @default(uuid())
  title                String
  description          String
  scheduledStart       DateTime
  scheduledEnd         DateTime
  isRecorded           Boolean              @default(false)
  streamPlatform       StreamPlatform       @default(YOUTUBE)
  status               SessionStatus        @default(SCHEDULED)
  streamUrl            String?
  thumbnailUrl         String?
  recordingUrl         String?
  duration             Int                  @default(0)
  hostId               String
  maxParticipants      Int                  @default(100)
  type                 SessionType          @default(ONE_TO_ONE)
  category             SessionCategory      @default(PODCAST)
  tags                 String[]
  accessLevel          AccessLevel          @default(PUBLIC)
  requiresRegistration Boolean              @default(false)
  registrationCount    Int                  @default(0)
  actualStartTime      DateTime?
  actualEndTime        DateTime?
  viewerCount          Int                  @default(0)
  chatEnabled          Boolean              @default(true)
  recordingEnabled     Boolean              @default(true)
  monetizationEnabled  Boolean              @default(false)
  allowQuestions       Boolean              @default(true)
  allowScreenShare     Boolean              @default(false)
  autoRecord           Boolean              @default(false)
  leaveSessionMessage  String?
  mediaProvider        MediaProvider        @default(WEBRTC_P2P)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  chats                Chat[]
  codeEditor           CodeEditor?
  polls                Poll[]
  questions            Question[]
  recordings           RecordingSession[]
  whiteboard           Whiteboard?
  webinarState         WebinarState?
  host                 User                 @relation(fields: [hostId], references: [id])
  participants         SessionParticipant[]

  @@index([hostId])
  @@index([category])
  @@index([scheduledStart])
}

model SessionParticipant {
  id        String          @id @default(uuid())
  sessionId String
  userId    String
  joinedAt  DateTime        @default(now())
  leftAt    DateTime?
  role      ParticipantRole @default(LISTENER)
  session   Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

model Plan {
  id               String         @id @default(uuid())
  name             String         @unique
  description      String
  price            Int            @default(0)
  duration         Int            @default(3)
  features         String[]
  benefits         String[]
  storage_quota_mb Int            @default(100)
  maxPodcasts      Int            @default(0)
  stripePriceId    String?        @unique
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]
  payments         Payment[]
}

model Subscription {
  id                              String    @id @default(uuid())
  userId                          String
  planId                          String
  status                          Status    @default(PENDING)
  startDate                       DateTime  @default(now())
  endDate                         DateTime?
  isActive                        Boolean   @default(true)
  autoRenew                       Boolean   @default(true)
  expiryMessage                   String?
  paymentId                       String?
  amount                          Int       @default(0)
  stripe_subscription_id          String?   @unique
  stripe_customer_id              String?
  payment_service_subscription_id String?   @unique
  payment_service_transaction_id  String?
  payments                        Payment[]
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  plan                            Plan      @relation(fields: [planId], references: [id])
  user                            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
}

model RecordingSession {
  id              String          @id @default(uuid())
  sessionId       String
  userId          String
  startedAt       DateTime        @default(now())
  endedAt         DateTime?
  duration        Int             @default(0)
  title           String
  status          RecordingStatus @default(PENDING)
  isPublic        Boolean         @default(false)
  fileUrl         String?
  fileSize        Int             @default(0)
  fileType        String?
  thumbnailUrl    String?
  isDownloadable  Boolean         @default(false)
  storageProvider StorageProvider @default(CLOUDINARY)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  session         Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
}

model Chat {
  id        String    @id @default(uuid())
  sessionId String
  userId    String
  message   String
  type      ChatType  @default(TEXT)
  edited    Boolean   @default(false)
  editedAt  DateTime?
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId])
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  planId          String?
  subscriptionId  String?
  amount          Int           @default(0)
  currency        String        @default("usd")
  paymentGateway  String
  paymentStatus   PaymentStatus @default(PENDING)
  transactionId   String        @unique
  paymentDate     DateTime      @default(now())
  purpose         String
  paidAt          DateTime?
  failureReason   String?
  stripeSessionId String?
  stripeInvoiceId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  plan            Plan?         @relation(fields: [planId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([paymentStatus])
}

model Whiteboard {
  id            String   @id @default(uuid())
  sessionId     String   @unique
  elements      Json
  currentTool   String   @default("pen")
  currentColor  String   @default("#000000")
  currentSize   Int      @default(2)
  collaborators String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CodeEditor {
  id            String   @id @default(uuid())
  sessionId     String   @unique
  code          String   @db.Text
  language      String   @default("javascript")
  output        String   @default("")
  isExecuting   Boolean  @default(false)
  collaborators String[]
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model WebinarState {
  id           String     @id @default(uuid())
  sessionId    String     @unique
  activePollId String?
  moderators   String[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  polls        Poll[]
  questions    Question[]
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Poll {
  id          String       @id @default(uuid())
  sessionId   String
  webinarId   String
  question    String
  isActive    Boolean      @default(true)
  createdById String
  expiresAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  options     PollOption[]
  votes       PollVote[]
  webinar     WebinarState @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([webinarId])
}

model PollOption {
  id        String     @id @default(uuid())
  pollId    String
  text      String
  order     Int
  votes     Int        @default(0)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollVotes PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(uuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
  @@index([userId])
}

model Question {
  id           String       @id @default(uuid())
  sessionId    String
  webinarId    String
  userId       String
  userName     String
  question     String
  upvotes      Int          @default(0)
  answered     Boolean      @default(false)
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar      WebinarState @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([sessionId, answered, upvotes])
  @@index([webinarId])
}

enum Role {
  user
  host
  admin
}

enum SubscriptionType {
  free
  premium
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum StreamPlatform {
  YOUTUBE
  TWITCH
  DISCORD
  OTHER
  ZOOM
  TEAMS
  AGORA
}

enum SessionCategory {
  PODCAST
  INTERVIEW
  PANEL
  WORKSHOP
  QNA
  OTHER
  EVENT
  EDUCATION
}

enum AccessLevel {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum ParticipantRole {
  SPEAKER
  LISTENER
  MODERATOR
}

enum SessionStatus {
  SCHEDULED
  WAITING
  ACTIVE
  ENDED
  CANCELLED
}

enum Status {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum StorageProvider {
  CLOUDINARY
  AWS_S3
  OTHER
}

enum RecordingStatus {
  PENDING
  RECORDING
  COMPLETED
  FAILED
}

enum ChatType {
  FILE
  IMAGE
  TEXT
  SYSTEM
}

enum SessionType {
  ONE_TO_ONE
  GROUP
  LIVE_EVENT
}

enum MediaProvider {
  WEBRTC_P2P
  MEDIASOUP
  AGORA
  OTHER
}
